{
    "$schema": "../../.schema/params.schema.json",
    "params": [
        {
            "name": "act_nocom",
            "display": "Action (ignoring comments)",
            "default": "N/A",
            "values": ["ACCEPT","DENY","INTERROGATE","DEFER","INTERROGATE lean ACCEPT","INTERROGATE lean DENY","DEFER lean ACCEPT","DEFER lean DENY"]
        },
        {
            "name": "reason_nocom",
            "display": "Reason",
            "default": "Comments indicate request changed substantially.",
            "ro-if-udf": ["act_nocom"],
            "nd-if-def": ["act_nocom"],
            "multiline": true
        },
        {
            "name": "act_com",
            "display": "Action (including comments)",
            "default": "N/A",
            "nd-if-udf": ["act_nocom"],
            "values": ["ACCEPT","DENY","INTERROGATE","DEFER","INTERROGATE lean ACCEPT","INTERROGATE lean DENY","DEFER lean ACCEPT","DEFER lean DENY"]
        },
        {
            "name": "reason_com",
            "display": "Reason",
            "default": "Action not different.",
            "ro-if-udf": ["act_com"],
            "nd-if-def": ["act_com"],
            "multiline": true
        }
    ]
}
